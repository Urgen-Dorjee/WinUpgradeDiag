<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:WinUpgradeDiag.App.ViewModels"
                    xmlns:ctl="clr-namespace:WinUpgradeDiag.App.Controls">

    <!--
        A small, deliberate design system. WPF's default control templates read as a 2006
        line-of-business app; a tool a technician opens under pressure needs clear hierarchy,
        generous spacing and colour that means something rather than decorates.
    -->

    <!-- ============================ Palette ============================ -->
    <!-- Neutrals: one ramp, used consistently for text, borders and surfaces. -->
    <Color x:Key="Ink900Color">#FF14181F</Color>
    <SolidColorBrush x:Key="Ink900" Color="{StaticResource Ink900Color}" />
    <SolidColorBrush x:Key="Ink700" Color="#FF3B444F" />
    <SolidColorBrush x:Key="Ink500" Color="#FF64707F" />
    <SolidColorBrush x:Key="Ink300" Color="#FF98A2B0" />
    <SolidColorBrush x:Key="Line200" Color="#FFE3E7EC" />
    <SolidColorBrush x:Key="Line100" Color="#FFF0F2F5" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SurfaceMuted" Color="#FFF7F8FA" />

    <!-- Brand -->
    <SolidColorBrush x:Key="Brand900" Color="#FF16324F" />
    <SolidColorBrush x:Key="Brand700" Color="#FF1F4B78" />
    <SolidColorBrush x:Key="Brand500" Color="#FF2D6CB0" />
    <SolidColorBrush x:Key="BrandTint" Color="#FFEDF3FA" />

    <!-- Severity: the only saturated colours in the app, so they carry meaning. -->
    <SolidColorBrush x:Key="CriticalFg" Color="#FF8E1F1F" />
    <SolidColorBrush x:Key="CriticalBg" Color="#FFFDECEC" />
    <SolidColorBrush x:Key="CriticalLine" Color="#FFF0BDBD" />

    <SolidColorBrush x:Key="WarningFg" Color="#FF8A5200" />
    <SolidColorBrush x:Key="WarningBg" Color="#FFFFF6E6" />
    <SolidColorBrush x:Key="WarningLine" Color="#FFF3D39A" />

    <SolidColorBrush x:Key="InfoFg" Color="#FF1B4F7A" />
    <SolidColorBrush x:Key="InfoBg" Color="#FFEDF4FB" />
    <SolidColorBrush x:Key="InfoLine" Color="#FFB9D3EE" />

    <SolidColorBrush x:Key="GoodFg" Color="#FF1D6234" />
    <SolidColorBrush x:Key="GoodBg" Color="#FFEDF7F0" />
    <SolidColorBrush x:Key="GoodLine" Color="#FFB2DCC0" />

    <SolidColorBrush x:Key="HighlightBg" Color="#FFFFF3C4" />

    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- ============================ Converters ============================ -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <vm:SeverityToBrushConverter x:Key="SeverityToForeground" Kind="Foreground" />
    <vm:SeverityToBrushConverter x:Key="SeverityToBackground" Kind="Background" />
    <vm:SeverityToBrushConverter x:Key="SeverityToBorder" Kind="Border" />
    <vm:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

    <!-- ============================ Typography ============================ -->
    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink900}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="HeadingText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink900}" />
        <Setter Property="Margin" Value="0,18,0,6" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Ink700}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Ink500}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Ink900}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- ============================ Buttons ============================ -->
    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="4" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource Brand700}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Ink900}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line200}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brand500}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- ============================ Inputs ============================ -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderBrush" Value="{StaticResource Line200}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Ink900}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ctl:PlaceholderService.Monitor" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Shell" CornerRadius="4" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <!-- Shown only while the box is empty: tells the operator the shape of
                                 a valid value, which a bare label above the box cannot. -->
                            <TextBlock x:Name="Placeholder"
                                       Text="{Binding (ctl:PlaceholderService.Text), RelativeSource={RelativeSource TemplatedParent}}"
                                       Margin="{TemplateBinding Padding}"
                                       Foreground="{StaticResource Ink300}"
                                       FontStyle="Italic"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding (ctl:PlaceholderService.IsEmpty), RelativeSource={RelativeSource Self}}"
                                     Value="True">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Brand500}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource Line100}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Ink700}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ============================ Tabs ============================ -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Ink500}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Root" Padding="16,10" Margin="0,0,2,0" Background="Transparent"
                            BorderThickness="0,0,0,2" BorderBrush="Transparent">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brand500}" />
                            <Setter Property="Foreground" Value="{StaticResource Brand700}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Line100}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Ink300}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Data grids ============================ -->
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="BorderBrush" Value="{StaticResource Line200}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="RowBackground" Value="{StaticResource Surface}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceMuted}" />
        <Setter Property="RowHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Line100}" />
        <Setter Property="Foreground" Value="{StaticResource Ink700}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="{StaticResource Line200}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource BrandTint}" />
                <Setter Property="Foreground" Value="{StaticResource Ink900}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================ Cards and chips ============================ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line200}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ScrollHost" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Padding" Value="0,0,12,0" />
    </Style>

</ResourceDictionary>
