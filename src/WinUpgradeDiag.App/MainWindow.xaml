<Window x:Class="WinUpgradeDiag.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinUpgradeDiag — Windows upgrade diagnostic"
        Width="1180" Height="780" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#1F3A5F" Padding="16,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="#C9D6E8" VerticalAlignment="Center"
                           Text="{Binding ToolVersion, Mode=OneWay}" />
                <StackPanel>
                    <TextBlock Text="WinUpgradeDiag" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Offline, read-only diagnostic for failed Windows 10 → 11 in-place upgrades"
                               Foreground="#C9D6E8" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="16">
            <!-- Idle state -->
            <StackPanel Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <TextBlock TextWrapping="Wrap" FontSize="15" Margin="0,0,0,12"
                           Text="Reads the upgrade, task sequence and servicing logs already on this machine, plus live process, WMI, storage and driver state. Nothing is changed and nothing leaves the machine." />
                <Button Content="Run diagnostic" Command="{Binding RunCommand}"
                        Padding="24,10" FontSize="15" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Running state -->
            <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Width="520">
                <TextBlock Text="Collecting…" FontSize="16" FontWeight="SemiBold" />
                <ProgressBar IsIndeterminate="True" Height="10" Margin="0,10" />
                <!-- DESIGN.md §5: never a spinner without a current-step label. -->
                <TextBlock Text="{Binding CurrentStep, Mode=OneWay}" TextWrapping="Wrap" Foreground="#444" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Left"
                        Padding="16,6" Margin="0,14,0,0" />
            </StackPanel>

            <!-- Results state -->
            <DockPanel Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">

                <!-- Verdict card (phase 1: plain summary, no verdict) -->
                <Border DockPanel.Dock="Top" Background="#EEF4FB" BorderBrush="#B9D3EE" BorderThickness="1"
                        CornerRadius="4" Padding="12" Margin="0,0,0,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Run again" Command="{Binding RunCommand}"
                                Padding="14,6" VerticalAlignment="Top" Margin="12,0,0,0" />
                        <StackPanel>
                            <TextBlock Text="Summary" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="{Binding Summary, Mode=OneWay}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TabControl>
                    <TabItem Header="Timeline" IsEnabled="False" ToolTip="Arrives with the parsers and rules engine (phase 2)." />
                    <TabItem Header="Findings" IsEnabled="False" ToolTip="Arrives with the parsers and rules engine (phase 2)." />

                    <!-- Logs tab -->
                    <TabItem Header="Logs" IsSelected="True">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="3*" />
                            </Grid.RowDefinitions>

                            <DataGrid Grid.Row="0" ItemsSource="{Binding ManifestRows}"
                                      SelectedItem="{Binding SelectedManifestRow, Mode=TwoWay}" Margin="0">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HighValue}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Exists}" Value="No">
                                                <Setter Property="Foreground" Value="#999" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category, Mode=OneWay}" Width="120" />
                                    <DataGridTextColumn Header="Log" Binding="{Binding Name, Mode=OneWay}" Width="220" />
                                    <DataGridTextColumn Header="Path" Binding="{Binding Path, Mode=OneWay}" Width="*" />
                                    <DataGridTextColumn Header="Exists" Binding="{Binding Exists, Mode=OneWay}" Width="55" />
                                    <DataGridTextColumn Header="Size" Binding="{Binding Size, Mode=OneWay}" Width="75" />
                                    <DataGridTextColumn Header="Last write" Binding="{Binding LastWrite, Mode=OneWay}" Width="140" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="170" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <DockPanel Grid.Row="1" Margin="0,8,0,4">
                                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Width="260" Text="{Binding ViewerFilter, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding ViewerStatus, Mode=OneWay}" Foreground="#555"
                                           VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                            </DockPanel>

                            <ListBox Grid.Row="2" ItemsSource="{Binding ViewerLines}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        </Grid>
                    </TabItem>

                    <!-- System tab -->
                    <TabItem Header="System">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding SystemFacts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="300" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Key, Mode=OneWay}" Foreground="#555" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value, Mode=OneWay}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Style="{StaticResource SectionHeader}" Text="Processes" />
                                <DataGrid ItemsSource="{Binding Processes}" MaxHeight="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Process" Binding="{Binding Name, Mode=OneWay}" Width="180" />
                                        <DataGridTextColumn Header="Running" Binding="{Binding IsRunning, Mode=OneWay}" Width="80" />
                                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId, Mode=OneWay}" Width="80" />
                                        <DataGridTextColumn Header="Started (UTC)" Binding="{Binding StartTimeUtc, Mode=OneWay, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Style="{StaticResource SectionHeader}" Text="Storage health" />
                                <DataGrid ItemsSource="{Binding StorageHealth}" MaxHeight="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Disk" Binding="{Binding FriendlyName, Mode=OneWay}" Width="*" />
                                        <DataGridTextColumn Header="Health" Binding="{Binding HealthStatus, Mode=OneWay}" Width="80" />
                                        <DataGridTextColumn Header="Wear" Binding="{Binding Wear, Mode=OneWay}" Width="70" />
                                        <DataGridTextColumn Header="Read errors (uncorr.)" Binding="{Binding ReadErrorsUncorrected, Mode=OneWay}" Width="150" />
                                        <DataGridTextColumn Header="Write errors (uncorr.)" Binding="{Binding WriteErrorsUncorrected, Mode=OneWay}" Width="150" />
                                        <DataGridTextColumn Header="Power-on hours" Binding="{Binding PowerOnHours, Mode=OneWay}" Width="120" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Style="{StaticResource SectionHeader}" Text="Filter drivers" />
                                <DataGrid ItemsSource="{Binding FilterDrivers}" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Service" Binding="{Binding ServiceName, Mode=OneWay}" Width="160" />
                                        <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName, Mode=OneWay}" Width="220" />
                                        <DataGridTextColumn Header="Altitude group" Binding="{Binding AltitudeGroup, Mode=OneWay}" Width="200" />
                                        <DataGridTextColumn Header="Image" Binding="{Binding ImagePath, Mode=OneWay}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Style="{StaticResource SectionHeader}" Text="Event log (System and Application, newest first)" />
                                <DataGrid ItemsSource="{Binding Events}" MaxHeight="320">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time (UTC)" Binding="{Binding TimeCreatedUtc, Mode=OneWay, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="140" />
                                        <DataGridTextColumn Header="Log" Binding="{Binding LogName, Mode=OneWay}" Width="85" />
                                        <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName, Mode=OneWay}" Width="190" />
                                        <DataGridTextColumn Header="ID" Binding="{Binding EventId, Mode=OneWay}" Width="55" />
                                        <DataGridTextColumn Header="Level" Binding="{Binding Level, Mode=OneWay}" Width="80" />
                                        <DataGridTextColumn Header="Message" Binding="{Binding Message, Mode=OneWay}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Style="{StaticResource SectionHeader}" Text="Collection gaps" />
                                <ItemsControl ItemsSource="{Binding CollectionErrors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Mode=OneWay}" TextWrapping="Wrap" Foreground="#A15C00" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Export tab -->
                    <TabItem Header="Export">
                        <StackPanel Margin="12" MaxWidth="720" HorizontalAlignment="Left">
                            <TextBlock Text="Output folder" FontWeight="SemiBold" />
                            <TextBox Text="{Binding OutputRoot, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />

                            <CheckBox Content="HTML report (self-contained, for the ticket)" IsChecked="{Binding ExportHtml}" Margin="0,2" />
                            <CheckBox Content="JSON (machine-readable, for fleet aggregation)" IsChecked="{Binding ExportJson}" Margin="0,2" />
                            <CheckBox Content="Evidence zip (collected logs; never redacted — internal escalation only)" IsChecked="{Binding ExportZip}" Margin="0,2" />

                            <CheckBox Content="Redact usernames, profile paths and machine name in HTML/JSON (recommended)"
                                      IsChecked="{Binding Redact}" Margin="0,12,0,2" FontWeight="SemiBold" />

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Export" Command="{Binding ExportCommand}" Padding="18,6" />
                                <Button Content="Open folder" Command="{Binding OpenExportFolderCommand}" Padding="14,6" Margin="8,0,0,0" />
                            </StackPanel>

                            <TextBlock Text="{Binding ExportStatus, Mode=OneWay}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Actions" IsEnabled="False" ToolTip="Remediation actions arrive in phase 4, once diagnosis is trusted." />
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
