<Window x:Class="WinUpgradeDiag.App.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:WinUpgradeDiag.App.Controls"
        Title="WinUpgradeDiag"
        Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Surface}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">

    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="PromptText" Style="{StaticResource BodyText}"
                   Foreground="{StaticResource Ink900}" FontWeight="SemiBold" />

        <!-- Where the value comes from. The field itself cannot convey that, and for a content id
             or a package id "where do I get this" is the actual question. -->
        <TextBlock x:Name="HelpText" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                   Visibility="Collapsed" />

        <TextBox x:Name="ValueInput" Margin="0,10,0,0" FontFamily="{StaticResource MonoFont}" />

        <TextBlock x:Name="ValidationText" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                   Foreground="{StaticResource WarningFg}" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click"
                    Style="{StaticResource SecondaryButton}" MinWidth="100" />
            <Button x:Name="OkButton" Content="OK" IsDefault="True" Click="Ok_Click"
                    Style="{StaticResource PrimaryButton}" MinWidth="100" Margin="10,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
